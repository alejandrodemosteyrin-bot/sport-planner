# Copy to .env and fill in. .env is gitignored — never commit it.

# Home starting point (decimal degrees). Kept out of the repo on purpose.
HOME_LAT=
HOME_LON=
HOME_LABEL=Home

# Timezone and report language
TIMEZONE=Europe/Madrid
REPORT_LANGUAGE=en

# Delivery: "email" (default, for testing the concept) or "telegram"
DELIVERY_CHANNEL=email

# Email via Gmail SMTP. GMAIL_USER is the sending Gmail account; GMAIL_APP_PASSWORD is a
# 16-character App Password (Google Account → Security → 2-Step Verification → App passwords),
# NOT your normal password. EMAIL_TO can be the same address.
EMAIL_TO=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Telegram bot (only needed when DELIVERY_CHANNEL=telegram; create with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Maps Platform — Routes API must be enabled on the key
GOOGLE_MAPS_API_KEY=

# Google Calendar OAuth (desktop client JSON downloaded from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_FILE=secrets/client_secret.json
# Comma-separated calendar ids to read; "primary" is your main calendar
GOOGLE_CALENDAR_IDS=primary

# AEMET OpenData API key (free, https://opendata.aemet.es/centrodedescargas/altaUsuario)
AEMET_API_KEY=

# Optional best-effort sources. Set to 0 to skip entirely.
ENABLE_SURF_FORECAST=1
ENABLE_WINDGURU=0

# Where tokens, snapshots and logs live (gitignored)
STATE_DIR=state
PREFERENCES_FILE=config/preferences.yaml
LOG_LEVEL=INFO
